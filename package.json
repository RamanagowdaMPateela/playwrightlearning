{
  "name": "playwrightlearning",
  "version": "1.0.0",
  "description": "Playwright with Typescript",
  "main": "index.js",
  "scripts": {
    "loginTest": "npx playwright test tests/demo/login.spec.ts --headed --project=chromium",
    "debugTest": "cross-env DEBUG=pw:api DEBUG=pw:api npx playwright test tests/demo/login.spec.ts --headed --project=chromium",
    "report": "npx allure generate ./allure-results --clean -o ./allure-report && npx allure open ./allure-report",
    "appointmentTest": "npx playwright test tests/demo/make.appointment.spec.ts --headed --project=chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.5.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
