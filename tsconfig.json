{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": false,
        "noImplicitAny": false,
        "types": [
            "node"
        ],
        "sourceMap": true,
        "outDir": "../tests-out",
    },
    "include": [
        "tests/**/*.ts",
         "debug/**/*.ts",
        "data/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}